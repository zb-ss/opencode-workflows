{
  "$schema": "./schema/workflows.schema.json",
  "schema_version": 1,
  "_comment_overview": "Workflow settings are separate from opencode.json. OpenCode's runtime model is inherited unless the installer is run with --materialize-models.",

  "_comment_model_candidates": "Candidates are tried in order by runtime integrations. Use either a provider/model string for migration compatibility or an object such as the inactive example below when a variant is required.",
  "_example_candidate": {
    "model": "provider/model",
    "variant": "variant-name"
  },
  "model_tiers": {
    "low": [],
    "mid": [],
    "high": []
  },

  "_comment_agent_models": "Optional per-agent candidate or ordered candidate arrays. Agent overrides take precedence over model_tiers.",
  "agent_models": {},
  "_comment_agent_variants": "Optional default variant per agent. A candidate object's variant takes precedence.",
  "agent_variants": {},
  "fallback_order": [],

  "default_mode": "standard",

  "_comment_automation": "Automatic workflow driving is opt-in. Limits are optional and should be configured before enabling automation.",
  "automation": {
    "enabled": false
  },

  "_comment_capabilities": "Capability values are disabled, auto, or required. Auto uses a capability when runtime support is detected. Required also stops automatic workflow start or resume when support is unavailable. These settings are never copied as unknown opencode.json keys.",
  "_comment_optional_integrations": "Experimental runtime support is detected from the documented OpenCode environment flags. Plugin v2 support is detected from the loaded plugin runtime.",
  "experimental_capabilities": {
    "background_subagents": "disabled",
    "native_workspaces": "disabled",
    "plugin_v2": "disabled",
    "mcp_code_mode": "disabled",
    "references": "disabled"
  },

  "_comment_delegation": "External CLI delegation is optional. The gemini routing token invokes Antigravity CLI (agy). Models are never pinned here; pass an explicit model to a delegation command only when needed.",
  "delegation": {
    "claude": {},
    "gemini": {},
    "fallback_order": [],
    "max_output_bytes": 1048576,
    "routing": {
      "ui_patterns": []
    },
    "auto_init_files": false
  },

  "_comment_swarm_config": "Swarm limits are optional. Empty provider_concurrency uses runtime settings rather than a baked provider list.",
  "swarm_config": {
    "provider_concurrency": {}
  }
}
