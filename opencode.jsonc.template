{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "CONVENTIONS.md"
  ],

  // Global model defaults (official OpenCode keys)
  "model": "google/gemini-3-pro",
  "small_model": "google/gemini-3-flash",

  // MCP servers - add your own here
  // See: https://opencode.ai/docs/config/mcp
  //
  // "mcp": {
  //   "github": {
  //     "type": "local",
  //     "enabled": true,
  //     "command": ["docker", "run", "-i", "--rm", "-e", "GITHUB_PERSONAL_ACCESS_TOKEN", "ghcr.io/github/github-mcp-server"],
  //     "environment": { "GITHUB_PERSONAL_ACCESS_TOKEN": "your-token-here" }
  //   },
  //   "playwright": {
  //     "type": "local",
  //     "enabled": true,
  //     "command": ["npx", "@playwright/mcp@latest"]
  //   },
  //   "context7": {
  //     "type": "local",
  //     "enabled": true,
  //     "command": ["npx", "-y", "@upstash/context7-mcp"]
  //   }
  // },
  "mcp": {},

  "permission": {
    "bash": {
      "git commit*": "ask",
      "git push*": "ask",
      "rm -rf*": "deny",
      "*": "allow"
    }
  },

  // Disable MCP tools globally, then enable per-agent below
  // Example: "github_*": false
  "tools": {},

  // Centralized model configuration
  //
  // 1) Set a global default model + small model
  // "model": "google/gemini-3-pro",
  // "small_model": "google/gemini-3-flash",
  //
  // 2) Override per-agent model in one place
  //    (recommended: commands in this repository intentionally do not pin models)
  //
  // "agent": {
  //   "build": { "model": "google/gemini-3-flash" },
  //   "supervisor": { "model": "google/gemini-3-pro" },
  //   "org-planner": { "model": "zhipu/glm-5" },
  //   "delegator": { "model": "google/gemini-3-pro" }
  // },
  //
  // 3) Commands inherit their configured agent model.
  //    (Use command-level overrides only when defining full command templates in config.)

  // Per-agent model/tool/permission overrides
  //
  "agent": {
    // "supervisor": { "model": "google/gemini-3-pro" },
    // "org-planner": { "model": "zhipu/glm-5" },
    // "delegator": { "model": "google/gemini-3-pro" },
    // "web-tester": {
    //   "tools": { "playwright_*": true, "chrome-devtools_*": true }
    // }
  }
}
