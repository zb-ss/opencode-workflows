{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencode-workflows.example/schema/publication-artifact.schema.json",
  "title": "Publication Artifact",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "blocked"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "workflow": {
      "type": "object",
      "properties": {
        "workflow_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\0]+$"
        },
        "root_session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\0]+$"
        }
      },
      "required": [
        "workflow_id",
        "root_session_id"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\0]+$"
        },
        "protection": {
          "type": "string",
          "enum": [
            "deny",
            "approval_required",
            "unprotected"
          ]
        }
      },
      "required": [
        "id",
        "display_name",
        "protection"
      ],
      "additionalProperties": false
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed"
            ]
          },
          "reason_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          }
        },
        "required": [
          "id",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "publisher": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "argv_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "environment_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "executable_identity_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "working_directory_identity_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "descriptor_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "argv_sha256",
            "environment_sha256",
            "executable_identity_sha256",
            "working_directory_identity_sha256",
            "descriptor_sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/publicationGitSnapshot"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "status",
    "created_at",
    "expires_at",
    "workflow",
    "target",
    "config_sha256",
    "gates",
    "publisher",
    "snapshot"
  ],
  "additionalProperties": false,
  "$defs": {
    "publicationGitSnapshot": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "source": {
          "type": "object",
          "properties": {
            "git_executable_identity_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "repository_identity_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "git_common_dir_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "object_format": {
              "type": "string",
              "enum": [
                "sha1",
                "sha256"
              ]
            },
            "base_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^refs\\/heads\\/[^\\u0000-\\u0020\\u007F~^:?*\\[\\]\\\\]+$"
            },
            "base_oid": {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            },
            "head_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^refs\\/heads\\/[^\\u0000-\\u0020\\u007F~^:?*\\[\\]\\\\]+$"
            },
            "head_oid": {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            },
            "tree_oid": {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            },
            "remote": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "remote_url": {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^(?:https|ssh):\\/\\/[^\\s\\0]+$"
            }
          },
          "required": [
            "git_executable_identity_sha256",
            "repository_identity_sha256",
            "git_common_dir_sha256",
            "object_format",
            "base_ref",
            "base_oid",
            "head_ref",
            "head_oid",
            "tree_oid",
            "remote",
            "remote_url"
          ],
          "additionalProperties": false
        },
        "target": {
          "type": "object",
          "properties": {
            "destination_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^refs\\/[^\\u0000-\\u0020\\u007F~^:?*\\[\\]\\\\]+$"
            }
          },
          "required": [
            "destination_ref"
          ],
          "additionalProperties": false
        },
        "scan_policy": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "limits": {
              "type": "object",
              "properties": {
                "max_commits": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "max_objects": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "max_blob_bytes": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "max_total_scan_bytes": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "max_findings": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "max_commits",
                "max_objects",
                "max_blob_bytes",
                "max_total_scan_bytes",
                "max_findings"
              ],
              "additionalProperties": false
            },
            "internal_markers_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "version",
            "limits",
            "internal_markers_sha256"
          ],
          "additionalProperties": false
        },
        "scan_counts": {
          "type": "object",
          "properties": {
            "commits": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "objects": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "blobs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "paths": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "findings": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "commits",
            "objects",
            "blobs",
            "paths",
            "bytes",
            "findings"
          ],
          "additionalProperties": false
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rule_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "category": {
                "type": "string",
                "enum": [
                  "credential",
                  "high_entropy",
                  "internal_marker",
                  "private_key",
                  "prohibited_path",
                  "token",
                  "unsupported_content"
                ]
              },
              "source_kind": {
                "type": "string",
                "enum": [
                  "bytes",
                  "git_blob",
                  "git_commit",
                  "git_object",
                  "git_path",
                  "path",
                  "text"
                ]
              },
              "location_identity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[^\\0\\r\\n]+$"
              },
              "fingerprint": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "rule_id",
              "category",
              "source_kind",
              "location_identity",
              "fingerprint"
            ],
            "additionalProperties": false
          }
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema_version",
        "source",
        "target",
        "scan_policy",
        "scan_counts",
        "findings",
        "snapshot_sha256"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "type": "object",
                "properties": {
                  "object_format": {
                    "const": "sha1"
                  }
                },
                "required": [
                  "object_format"
                ]
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "properties": {
              "source": {
                "type": "object",
                "properties": {
                  "base_oid": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                  },
                  "head_oid": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                  },
                  "tree_oid": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "source": {
                "type": "object",
                "properties": {
                  "base_oid": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "head_oid": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "tree_oid": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "status": {
            "const": "ready"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "gates": {
            "type": "array",
            "not": {
              "contains": {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "failed"
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          },
          "snapshot": {
            "type": "object",
            "properties": {
              "findings": {
                "type": "array",
                "maxItems": 0
              }
            },
            "required": [
              "findings"
            ]
          },
          "publisher": {
            "type": "object"
          }
        }
      },
      "else": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "gates": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "failed"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            },
            "required": [
              "gates"
            ]
          },
          {
            "type": "object",
            "properties": {
              "snapshot": {
                "type": "object",
                "properties": {
                  "findings": {
                    "type": "array",
                    "minItems": 1
                  }
                },
                "required": [
                  "findings"
                ]
              }
            },
            "required": [
              "snapshot"
            ]
          }
        ]
      }
    }
  ]
}
