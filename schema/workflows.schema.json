{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencode-workflows.example/schema/workflows.schema.json",
  "title": "OpenCode Workflows Configuration",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "model_tiers": {
      "type": "object",
      "properties": {
        "low": { "$ref": "#/$defs/candidateList" },
        "mid": { "$ref": "#/$defs/candidateList" },
        "high": { "$ref": "#/$defs/candidateList" }
      },
      "required": ["low", "mid", "high"],
      "additionalProperties": false
    },
    "agent_models": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/candidate" },
          { "$ref": "#/$defs/candidateList" }
        ]
      }
    },
    "agent_variants": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/variant" }
    },
    "fallback_order": { "$ref": "#/$defs/candidateList" },
    "default_mode": { "type": "string", "minLength": 1 },
    "plans_dir": { "type": "string", "minLength": 1 },
    "automation": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "max_parallel_sessions": { "type": "integer", "minimum": 1 },
        "max_sessions": { "type": "integer", "minimum": 1 },
        "max_attempts_per_stage": { "type": "integer", "minimum": 1 },
        "max_wall_time_ms": { "type": "integer", "minimum": 1 },
        "max_input_tokens": { "type": "integer", "minimum": 0 },
        "max_output_tokens": { "type": "integer", "minimum": 0 },
        "max_cost_usd": { "type": ["number", "null"], "minimum": 0 }
      },
      "required": ["enabled"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          },
          "then": {
            "required": [
              "max_parallel_sessions",
              "max_sessions",
              "max_attempts_per_stage",
              "max_wall_time_ms",
              "max_input_tokens",
              "max_output_tokens",
              "max_cost_usd"
            ]
          }
        }
      ]
    },
    "experimental_capabilities": {
      "type": "object",
      "properties": {
        "background_subagents": { "$ref": "#/$defs/capabilityMode" },
        "native_workspaces": { "$ref": "#/$defs/capabilityMode" },
        "plugin_v2": { "$ref": "#/$defs/capabilityMode" },
        "mcp_code_mode": { "$ref": "#/$defs/capabilityMode" },
        "references": { "$ref": "#/$defs/capabilityMode" }
      },
      "additionalProperties": false
    },
    "delegation": {
      "type": "object",
      "properties": {
        "claude": { "$ref": "#/$defs/delegationProvider" },
        "gemini": { "$ref": "#/$defs/delegationProvider" },
        "default_provider": { "enum": ["auto", "claude", "gemini"] },
        "fallback_order": {
          "type": "array",
          "items": { "enum": ["claude", "gemini"] },
          "uniqueItems": true
        },
        "max_parallel": { "type": "integer", "minimum": 1 },
        "max_review_iterations": { "type": "integer", "minimum": 1 },
        "max_output_bytes": { "type": "integer", "minimum": 1 },
        "auto_init_files": { "type": "boolean" },
        "routing": {
          "type": "object",
          "properties": {
            "ui_patterns": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "default_provider": { "enum": ["claude", "gemini"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "swarm_config": {
      "type": "object",
      "properties": {
        "default_concurrency": { "type": "integer", "minimum": 1 },
        "stale_timeout_ms": { "type": "integer", "minimum": 1 },
        "poll_interval_ms": { "type": "integer", "minimum": 1 },
        "progress_timeout_ms": { "type": "integer", "minimum": 1 },
        "provider_concurrency": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "model_tiers",
    "agent_models",
    "agent_variants",
    "fallback_order",
    "default_mode",
    "automation",
    "experimental_capabilities"
  ],
  "additionalProperties": false,
  "$defs": {
    "modelId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/\\S+$"
    },
    "variant": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "candidate": {
      "oneOf": [
        { "$ref": "#/$defs/modelId" },
        {
          "type": "object",
          "properties": {
            "model": { "$ref": "#/$defs/modelId" },
            "variant": { "$ref": "#/$defs/variant" }
          },
          "required": ["model"],
          "additionalProperties": false
        }
      ]
    },
    "candidateList": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    },
    "capabilityMode": {
      "enum": ["disabled", "auto", "required"]
    },
    "delegationProvider": {
      "type": "object",
      "properties": {
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "permission_mode": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
