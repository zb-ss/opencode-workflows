                        "contract",
                        "semantic",
                        "ambiguous_launch",
                        "cancelled"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "running",
                    "passed",
                    "failed",
                    "cancelled"
                  ]
                }
              },
              "required": [
                "attempt_id",
                "agent",
                "model",
                "child_session_id",
                "started_at",
                "completed_at",
                "checkpoint_commit",
                "review_evidence_digest",
                "result_summary",
                "failure_classification",
                "status"
              ],
              "additionalProperties": false
            }
