                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "checkpoint_commit": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                    },
                    {
                      "type": "null"
