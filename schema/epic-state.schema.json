                  ]
                },
                "review_evidence_digest": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "result_summary": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "failure_classification": {
