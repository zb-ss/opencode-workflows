{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencode-workflows.example/schema/epic-state.schema.json",
  "title": "Epic State",
  "description": "Structural schema for epic state version 2.",
  "$comment": "Authoritative runtime validation additionally enforces DAG, transition, identity, timestamp, digest, scoped usage, budget hierarchy, ownership, and revision-order invariants that JSON Schema cannot express.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 2
    },
    "state_revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "operational_limits": {
      "type": "object",
      "properties": {
        "max_epic_items": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 256
        },
        "max_item_dependencies": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 64
        },
        "max_attempts_per_item": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 32
        },
        "max_budget_records": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 4096
        }
      },
      "required": [
        "max_epic_items",
        "max_item_dependencies",
        "max_attempts_per_item",
        "max_budget_records"
      ],
      "additionalProperties": false
    },
    "epic_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "root_session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "project_identity_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "base_branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "integration_branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "paused",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "pause_reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
